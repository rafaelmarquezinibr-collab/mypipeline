# Banco (Supabase > Project Settings > Database > Connection string)
# Use a URL do "Transaction pooler" (porta 6543) na Vercel.
DATABASE_URL=postgres://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Login (o app é só seu: uma senha)
APP_PASSWORD=
# Texto aleatório longo (ex.: openssl rand -hex 32)
SESSION_SECRET=

# URL pública do app, sem barra no final
APP_URL=https://seu-app.vercel.app

# Protege o endpoint de lembretes (/api/cron/lembretes)
CRON_SECRET=
# Protege o link da agenda para o Outlook (/api/calendario?token=...)
CALENDAR_TOKEN=

# Notificação no celular (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# E-mail via Resend (resend.com)
RESEND_API_KEY=
REMINDER_EMAIL_TO=voce@exemplo.com
# Sem domínio verificado no Resend, use onboarding@resend.dev (só envia para o e-mail da sua conta Resend)
REMINDER_EMAIL_FROM=Funil <onboarding@resend.dev>

# WhatsApp via CallMeBot (callmebot.com/blog/free-api-whatsapp-messages)
CALLMEBOT_PHONE=+5511999999999
CALLMEBOT_APIKEY=
